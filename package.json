{
  "name": "@nerima-games/mc-save",
  "version": "0.5.0",
  "type": "module",
  "description": "Strict Minecraft save-format codecs and storage primitives for the nerima-games Minecraft-clone rebuild.",
  "homepage": "https://github.com/nerima-games/mc-save#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-save.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-save/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "persistence",
    "codec"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "bench:durable-save": "tsx src/entrypoints/bench-durable-save.ts",
    "check:source-policy": "node scripts/check-source-policy.mjs",
    "lint": "oxlint --deny-warnings src scripts test && ast-grep scan",
    "lint:fix": "oxlint --fix src scripts test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify",
    "test": "vitest run",
    "test:browser": "pnpm typecheck:browser && vitest --config vitest.browser.config.ts run",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "typecheck:browser": "tsc -p tsconfig.browser.json --pretty false",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.9.0",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/vitest": "4.0.5",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.42.1",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
