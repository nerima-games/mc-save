{
  "name": "@nerima-games/mc-save",
  "version": "0.2.2",
  "type": "module",
  "description": "Strict Minecraft save-format codecs and storage primitives for the nerima-games Minecraft-clone rebuild.",
  "homepage": "https://github.com/nerima-games/mc-save#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-save.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-save/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "persistence",
    "codec"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "typecheck:browser": "tsc -p tsconfig.browser.json --pretty false",
    "check:source-policy": "node scripts/check-source-policy.mjs",
    "scripts:check": "node --check scripts/check-source-policy.mjs && node --check scripts/verify-package.mjs",
    "build": "tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test",
    "lint:fix": "oxlint --fix src scripts test",
    "test": "vitest run",
    "pretest": "pnpm build",
    "test:watch": "vitest",
    "test:browser": "pnpm typecheck:browser && vitest --config vitest.browser.config.ts run",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "pretest:coverage": "pnpm build",
    "verify": "pnpm typecheck && pnpm check:source-policy && pnpm scripts:check && pnpm lint && pnpm test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.4.0",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.75.0",
    "playwright": "1.62.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
