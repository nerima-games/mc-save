{
  "name": "@nerima-games/mc-save",
  "version": "0.2.2",
  "type": "module",
  "description": "Persistence toolkit for the nerima-games Minecraft-clone rebuild: versioned save formats with migration chains, a format registry, and the StoragePort with an in-memory adapter.",
  "homepage": "https://github.com/nerima-games/mc-save#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-save.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-save/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "docs",
    "tsconfig.base.json",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "voxel",
    "persistence",
    "migration",
    "codec"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "lint": "oxlint --deny-warnings src scripts test",
    "lint:fix": "oxlint --fix src scripts test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures:write": "tsx scripts/write-save-fixtures.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@effect/vitest": "^0.30.0",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^3.2.7"
  }
}
