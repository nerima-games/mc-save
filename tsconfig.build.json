{
  // Shipped source only. `types: []` (inherited) is deliberate: if a Node type
  // ever leaks into domain code this project fails, which is what keeps the
  // codec toolkit usable from browser, worker and server alike.
  "extends": "./tsconfig.base.json",
  "include": ["src/index.ts", "src/domain/**/*.ts"],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "test/**",
    "scripts/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
