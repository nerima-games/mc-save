{
  // Shared compiler options for every tsconfig in this repository.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM, no WebWorker, no Node globals.
    //
    // mc-save ships a codec toolkit, a StoragePort *contract*, and an IndexedDB
    // adapter — and none of them knows what a browser is.
    //
    // An earlier version of this comment said the IndexedDB adapter would have
    // to add "DOM" here when it landed. IT LANDED AND IT DID NOT, and the reason
    // is worth stating where the temptation is:
    //
    // adding "DOM" would make `pnpm typecheck` stop proving that the toolkit is
    // platform-free. Every file under domain/ would silently become able to
    // reach `window`, `document` and `localStorage`, and nothing would notice
    // for months. Instead `domain/indexeddb-surface.ts` describes, structurally,
    // the handful of IndexedDB members the adapter uses, and
    // `test/fixtures/indexeddb-surface.ts` is COMPILED BY A TEST against the
    // real `lib.dom.d.ts` to prove a real `IDBFactory` satisfies it with no
    // cast. Same pattern as mc-render's `application/dom-surface.ts`.
    //
    // So this line is now load-bearing in both directions, and a test asserts
    // it: `test/indexeddb-storage.test.ts`, "the shipped project still compiles
    // with NO DOM at all". If you are here to add "DOM", that test is where the
    // argument against it is written down.
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // No build step yet (see README 現状). Every tsconfig here is check-only;
    // `package.json#exports` points at TypeScript source. The emitting
    // build/publish pipeline is added when this repo reaches completion.
    "noEmit": true,

  }
}
